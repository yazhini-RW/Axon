# Copy to .env and fill in only if you want to. Axon runs fine with NONE of these set.
# With no .env at all, Axon uses its rule-based mock brain and stays fully offline.

# Optional. Free key from Google AI Studio: https://aistudio.google.com/apikey
# When set, Axon uses Gemini instead of the mock brain. See docs/adr/0005-gemini-brain.md
# — this path has not been tested against a real key, only against a stubbed client.
# GEMINI_API_KEY=

# Optional. Bigger embedding model = better recall, bigger download (1.2GB vs 134MB).
# AXON_EMBED_MODEL=thenlper/gte-large

# Optional. Where Axon keeps its database, vector store and checkpoints.
# AXON_DATA_DIR=./data
